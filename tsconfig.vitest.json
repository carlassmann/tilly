{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true
	},
	"include": [
		".astro/types.d.ts",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.ts",
		"src/**/*.spec.tsx",
		"src/**/*.test-d.ts",
		"src/**/test-helpers.ts",
		"src/**/test-helpers.tsx",
		"test-stubs/**/*.ts"
	],
	"exclude": ["node_modules", "dist"]
}
